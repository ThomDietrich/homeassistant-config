input_datetime:
  aquarium_beleuchtung_on:
    name: Aquarium Beleuchtung Einschaltzeit
    has_date: false
    has_time: true
    #initial: "08:00"
  aquarium_beleuchtung_off:
    name: Aquarium Beleuchtung Ausschaltzeit
    has_date: false
    has_time: true
    #initial: "20:00"

automation:
  - id: "1609203916747"
    alias: Aquarium Beleuchtung früh ein
    trigger:
      #  - trigger: time
      #    at: "08:00"
      - trigger: time
        at: input_datetime.aquarium_beleuchtung_on
    action:
      - action: light.turn_on
        entity_id: light.bad_aquarium_beleuchtung

  - id: "1609203916748"
    alias: Aquarium Beleuchtung abends aus
    trigger:
      #  - trigger: time
      #    at: "20:00"
      - trigger: time
        at: input_datetime.aquarium_beleuchtung_off
    action:
      - action: light.turn_off
        entity_id: light.bad_aquarium_beleuchtung
